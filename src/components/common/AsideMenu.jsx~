"use client";
import { useState } from "react";
import { useRouter, usePathname } from "next/navigation";

const asideMenuItems = [
    { label: "Dashboard", path: "/admin" },
    {
        label: "Projects",
        path: "/admin/project",
        // subMenu: [
        //   { label: "Create Project", path: "/admin/project/create-new-project" },
        //   { label: "View Projects", path: "/admin/project" }
        // ]
    },
    { label: "Blogs", path: "/admin/blogs" },
    // { label: "Users", path: "/admin/users" },
    // { label: "Logout", path: "/admin/logout" },
];

const AsideMenu = () => {
    const [openMenu, setOpenMenu] = useState(null);
    const router = useRouter();
    const pathname = usePathname(); // Get the current path dynamically

    const handleMenuClick = (path) => {
        router.push(path);
    };

    const handleLogout = () => {
        document.cookie =
            "uidToken=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC; Secure; SameSite=None";
        router.push("/login");
    };

    return (
        <aside className="w-[300px] flex flex-col h-full border-r border-slate-800 flex-shrink-0 fixed left-0 ">
            <ul className="pt-10 flex flex-col gap-2 px-2">
                {asideMenuItems.map((item) => (
                    <li key={item.label}>
                        <div
                            className={`flex items-center px-4 py-2 hover:bg-slate-900 cursor-pointer rounded-lg ${
                                pathname === item.path ? "bg-slate-800 text-white" : ""
                            }`}
                            onClick={() => handleMenuClick(item.path)}
                        >
                            {item.label}
                        </div>
                    </li>
                ))}
            </ul>
            <div className="p-2 absolute bottom-24 left-4">
                <button
                    onClick={handleLogout}
                    className="bg-red-900 w-full h-full px-24 py-4 rounded-lg font-bold hover:bg-red-700 duration-200"
                >
                    Logout
                </button>
            </div>
        </aside>
    );
};

export default AsideMenu;

